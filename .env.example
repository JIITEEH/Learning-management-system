# Copy to .env and fill in. .env is gitignored.

PORT=3000
NODE_ENV=development

# MySQL connection
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=lms

# Signs the session cookie. In production the server refuses to start unless
# this is a random string of at least 32 characters. Make one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=change-me

# Leave empty on your own computer. On a server behind nginx (or any other
# proxy), set to the number of proxies in front of the app — usually 1 — so
# the app sees each visitor's real address and knows they used HTTPS.
# Never set to true: anyone could then fake their address.
TRUST_PROXY=

# The site's own address, used for links in emails (password reset). Change it
# when the site goes online, e.g. https://learnhub.example.edu
APP_URL=http://localhost:3000

# Outgoing email, for password reset links. Leave SMTP_HOST empty and emails
# are printed in the terminal instead, which is enough on your own computer.
# Gmail is free: turn on 2-step verification, create an app password at
# https://myaccount.google.com/apppasswords, and use it as SMTP_PASS (not the
# account's normal password).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
