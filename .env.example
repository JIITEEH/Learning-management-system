# Copy to .env and fill in. .env is gitignored.

PORT=3000
NODE_ENV=development

# MySQL connection
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=lms

# Signs the session cookie. Use a long random string in production.
SESSION_SECRET=change-me

# Leave empty on your own computer. On a server behind nginx (or any other
# proxy), set to the number of proxies in front of the app — usually 1 — so
# the app sees each visitor's real address and knows they used HTTPS.
# Never set to true: anyone could then fake their address.
TRUST_PROXY=
