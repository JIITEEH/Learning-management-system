{
  "name": "lms",
  "version": "0.1.0",
  "private": true,
  "description": "Learning Management System",
  "workspaces": [
    "server"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "npm run dev -w server",
    "start": "npm run start -w server",
    "db:setup": "npm run db -w server -- setup",
    "db:schema": "npm run db -w server -- schema",
    "db:seed": "npm run db -w server -- seed",
    "db:reset": "npm run db -w server -- reset",
    "db:migrate": "npm run db -w server -- migrate",
    "db:status": "npm run db -w server -- status",
    "lint": "eslint . --max-warnings 0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^17.12.0"
  }
}
